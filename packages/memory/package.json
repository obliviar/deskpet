    "test:stage3-blind": "vitest run src/eval/stage3-external-blind.test.ts --reporter=verbose",
    "test:stage3-bge": "vitest run src/eval/stage3-bge-comparison.test.ts --reporter=verbose"
  },
  "dependencies": {
    "@deskpet/contracts": "workspace:*",
    "openai": "^4.73.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.6.3",
    "vitest": "^2.1.0"
  }
}
