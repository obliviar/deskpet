{
  "name": "@deskpet/memory",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Persistent and isolated long-term memory",
  "license": "MIT",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "build": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
